# ═══════════════════════════════════════════════════════════════════════════
#  Renox Planner — نمونه متغیرهای محیطی
#  کپی کنید با:  cp .env.example .env
#  ⚠️ همه این‌ها «اختیاری» هستند؛ برنامه بدون هیچ کلیدی هم کامل کار می‌کند.
#  فایل .env در .gitignore است و هرگز در مخزن قرار نمی‌گیرد.
# ═══════════════════════════════════════════════════════════════════════════

# ──────────────────────────── حالت اجرا ────────────────────────────────────
# local  = فقط مرورگر (پیش‌فرض، بدون سرور، مناسب GitHub Pages)
# server = همراه با پایگاه‌داده و ورود کاربران (نیازمند npm run server:enable)
NEXT_PUBLIC_SERVER_MODE=local

# مسیر پایه برای انتشار در زیرمسیر (GitHub Pages) — خالی یعنی ریشه دامنه
# مثال: /Renox-Planner
NEXT_PUBLIC_BASE_PATH=
GITHUB_PAGES=false

# ────────────────────── پایگاه‌داده (فقط حالت سروری) ───────────────────────
# PostgreSQL نمونه:  postgresql://user:pass@localhost:5432/renox?schema=public
# SQLite برای شروع سریع:  file:./dev.db   (و provider را در schema.prisma عوض کنید)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/renox?schema=public"

# ────────────────────── احراز هویت (فقط حالت سروری) ────────────────────────
# ساخت کلید:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ورود با گوگل (اختیاری، رایگان) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────── اعلان: تلگرام (رایگان، اختیاری) ─────────────────────
# توکن را از @BotFather بگیرید و chatId را از @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────── اعلان: Web Push / VAPID (رایگان) ─────────────────────
# ساخت کلیدها:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─────────────────── اعلان: ایمیل (اختیاری، سهمیه رایگان) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Renox Planner <no-reply@example.com>"

# ─────────────── کلیدهای APIهای رایگان (همه اختیاری) ───────────────────────
# توجه: هیچ‌یک از این‌ها برای کارکرد برنامه لازم نیست.
# جدول کامل سرویس‌ها و محدودیت‌ها: API_INTEGRATIONS.md

# Groq — خلاصه‌سازی هوشمند ژورنال (رایگان)  https://console.groq.com/keys
NEXT_PUBLIC_GROQ_API_KEY=

# Hugging Face — تحلیل متن (رایگان)  https://huggingface.co/settings/tokens
NEXT_PUBLIC_HF_API_KEY=

# Alpha Vantage — سهام (۲۵ درخواست رایگان در روز)  https://www.alphavantage.co/support/#api-key
NEXT_PUBLIC_ALPHA_VANTAGE_KEY=

# TMDb — فهرست تماشا (رایگان)  https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=

# OMDb — جایگزین TMDb (۱۰۰۰ درخواست رایگان در روز)  https://www.omdbapi.com/apikey.aspx
NEXT_PUBLIC_OMDB_API_KEY=

# Currents — اخبار (۶۰۰ درخواست رایگان در روز)  https://currentsapi.services/en
NEXT_PUBLIC_CURRENTS_API_KEY=

# Wger — تمرین‌های ورزشی (رایگان با ثبت‌نام)  https://wger.de
NEXT_PUBLIC_WGER_TOKEN=

# ─────────────────── سرویس‌هایی که کلید لازم ندارند ────────────────────────
# برای یادآوری، این‌ها همیشه فعال‌اند و در .env نیازی به تنظیم ندارند:
#   Open-Meteo، Quotable، Nager.Date، open.er-api.com، Frankfurter، CoinGecko،
#   Open Food Facts، Free Dictionary، LibreTranslate، MyMemory، LanguageTool،
#   The Color API، goQR، CleanURI، WorldTimeAPI، Open Library، Lorem Picsum
