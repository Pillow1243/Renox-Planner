{
  "name": "renox-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Renox Planner — برنامه‌ریز جامع زندگی (فارسی، RTL، PWA)",
  "author": "Renox",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "build:pages": "GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/Renox-Planner next build",
    "start": "npx --yes serve@14 out -l 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/setup.mjs --test tests/*.test.ts",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:push": "prisma db push --schema server/prisma/schema.prisma",
    "db:seed": "node --import tsx server/prisma/seed.ts",
    "server:enable": "node scripts/enable-server.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/vazirmatn": "^5.0.20",
    "@tanstack/react-query": "^5.51.1",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.8",
    "lucide-react": "^0.417.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
